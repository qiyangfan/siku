{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "siku",
  "version": "0.1.0",
  "identifier": "com.qiyangfan.siku",
  "build": {
    "frontendDist": "shell-ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "siku 四库",
        "url": "index.html",
        "width": 1200,
        "height": 820,
        "minWidth": 960,
        "minHeight": 640
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": false,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": {
      "../dist": "dist",
      "binaries/siku-sidecar": "siku-sidecar"
    },
    "macOS": {
      "minimumSystemVersion": "10.15"
    }
  }
}
